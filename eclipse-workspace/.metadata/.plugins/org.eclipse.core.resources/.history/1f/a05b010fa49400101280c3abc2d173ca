	// Verifica se una stringa è un CAP italiano valido (5 cifre).
	public static void main(String[] args) {
        String[] testCAP = {"00100", "12345", "ABCDE", "1234", "123456", "12 345"};

        for (String cap : testCAP) {
            if (cap.matches("^\\d{5}$")) {
                System.out.println("CAP: " + cap + " -> Valido");
            } else {
                System.out.println("CAP: " + cap + " -> Non valido");
            }
        }
    } 
	

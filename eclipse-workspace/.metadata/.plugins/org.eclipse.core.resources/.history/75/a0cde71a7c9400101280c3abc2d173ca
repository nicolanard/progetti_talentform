	//Usare BiConsumer per stampare chiave e valore
	public static void main(String[] args) {
        Map<String, Integer> mappa = new HashMap<>();
        mappa.put("Mario", 25);
        mappa.put("Luca", 30);
        mappa.put("Anna", 22);

        BiConsumer<String, Integer> stampaCoppia = (chiave, valore) -> System.out.println("Chiave: " + chiave + ", Valore: " + valore);
        mappa.forEach(stampaCoppia);
    } 
	
	// Contare elementi con filter
	public static void main(String[] args) {
        List<Integer> numeri = Arrays.asList(1, 2, 3, 4, 5, 6, 8, 10);

        long pari = numeri.stream()
            .filter(n -> n % 2 == 0)
            .count();

        System.out.println("Numeri pari: " + pari);
    } 
	
	// Somma di numeri con reduce
	public static void main(String[] args) {
        List<Integer> numeri = Arrays.asList(1, 2, 3, 4, 5);

        int somma = numeri.stream()
            .reduce(0, (a, b) -> a + b); 

        System.out.println("Somma: " + somma);
    }
	
	//Trova il massimo con una lambda
	public static void main(String[] args) {
        List<Integer> numeri = Arrays.asList(10, 45, 3, 99, 27);

        Optional<Integer> massimo = numeri.stream().max((a, b) -> a - b);

        massimo.ifPresent(m -> System.out.println("Valore massimo: " + m));
    } 

	//Verificare se almeno un elemento soddisfa condizione
	public static void main(String[] args) {
        List<Integer> numeri = Arrays.asList(10, 25, 150, 30);

        boolean esiste = numeri.stream()
            .anyMatch(n -> n > 100);

        System.out.println("Almeno un numero > 100? " + esiste);
    } 
	

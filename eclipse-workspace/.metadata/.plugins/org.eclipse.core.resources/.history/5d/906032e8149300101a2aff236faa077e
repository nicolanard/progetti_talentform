	// Rimuovi tutti i valori maggiori della media
	public static void main(String[] args) {
        ArrayList<Integer> numeri = new ArrayList<>();
        numeri.add(5);
        numeri.add(10);
        numeri.add(15);
        numeri.add(20);
        numeri.add(25);

        System.out.println("Lista originale: " + numeri);

        double somma = 0;
        for (int num : numeri) {
            somma += num;
        }
        double media = somma / numeri.size();
        System.out.println("Media: " + media);

        numeri.removeIf(n -> n > media);

        System.out.println("Lista dopo rimozione: " + numeri);
    } 
	
	//Trova il massimo incremento consecutivo
	public static void main(String[] args) {
		ArrayList<Integer> seq = new ArrayList<>(List.of(1,2,2,3,5,6,6,7));
		int maxLen=1,len=1;
		for(int i=1;i<seq.size();i++){
		    if(seq.get(i)>seq.get(i-1)) len++;
		    else len=1;
		    maxLen=Math.max(maxLen,len);
		}
		System.out.println(maxLen);
    } 
	
	//crea l'unione di due insiemi con HashSet
	public static void main(String[] args) {
        // Crea due HashSet di stringhe
        HashSet<String> set1 = new HashSet<>();
        set1.add("mela");
        set1.add("banana");
        set1.add("kiwi");

        HashSet<String> set2 = new HashSet<>();
        set2.add("banana");
        set2.add("arancia");
        set2.add("uva");

        // Unione dei due set
        HashSet<String> unione = new HashSet<>(set1); // copia set1
        unione.addAll(set2); // aggiunge tutti gli elementi di set2

        // Stampa il risultato
        System.out.println("Unione degli insiemi: " + unione);
    } 
        

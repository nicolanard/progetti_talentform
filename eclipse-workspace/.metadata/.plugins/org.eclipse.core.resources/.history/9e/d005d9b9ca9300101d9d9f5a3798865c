	//Trova la chiave con valore massimo
	public static void main(String[] args) {
		HashMap<String, Integer> mappa = new HashMap<>(Map.of("A", 10, "B", 6, "C", 9));
        
        String maxKey = Collections.max(mappa.entrySet(),Map.Entry.comparingByValue()).getKey(); //trovare chiave massima mettendo a confronto i valori(Collections/Map)
        
        System.out.println("Ecco la chiave con valore massimo: " + maxKey);
        
        System.out.println("");
        
        String minKey = Collections.min(mappa.entrySet(),Map.Entry.comparingByValue()).getKey(); //trovare chiave minima mettendo a confronto i valori(Collections/Map)
        
        System.out.println("Ecco la chiave con valore minimo: " + minKey);
	} 
	
	//Unisci due mappe sommando i valori
	public static void main(String[] args) {
		HashMap<String, Integer> mappa1 = new HashMap<>();
		
		mappa1.put("A", 10);
		mappa1.put("B", 8);
		
		HashMap<String, Integer> mappa2 = new HashMap<>();
		
		mappa2.put("C", 6);
		mappa2.put("D", 4);
		mappa2.put("F", 1);
		
		HashMap<String, Integer> mappa3 = new HashMap<>(mappa1);
		
		for(Map.Entry<String, Integer> entry : mappa2.entrySet()) {
			mappa3.merge(entry.getKey(), entry.getValue(), Integer::sum);
		}
		
		System.out.println("La nuova mappa, mostra i seguenti valori: " + mappa3);
			
	} 
	

	//Ordina la mappa per valore
	public static void main(String[] args) {                                                    
		HashMap<String, Integer> map = new HashMap<>(Map.of("B", 7, "A", 5, "C", 6));
        TreeMap<String, Integer> map2 = new TreeMap<>(map);
        System.out.println("mappa" + map2);


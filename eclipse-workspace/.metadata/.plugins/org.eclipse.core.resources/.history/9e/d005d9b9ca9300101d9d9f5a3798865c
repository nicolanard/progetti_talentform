	//Concatena tutte le stringhe in una frase
	
	public static void main(String[] args) {
	        ArrayList<String> parole = new ArrayList<>();
	        parole.add("Ciao");
	        parole.add("come");
	        parole.add("stai");
	        parole.add("oggi?");

	        Iterator<String> iterator = parole.iterator();

	        StringBuilder frase = new StringBuilder();

	        while (iterator.hasNext()) {
	            frase.append(iterator.next());
	            if (iterator.hasNext()) {
	                frase.append(" ");
	            }
	        }

	        System.out.println(frase.toString());
